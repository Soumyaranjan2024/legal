# =============================================================================
# Legal Information Retrieval System - environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- LLM --------------------------------------------------------------------
# Grok (xAI) is preferred. If XAI_API_KEY is empty, a configured GROQ_API_KEY
# (Groq, OpenAI-compatible) is used, and Gemini is used when only a
# GEMINI_API_KEY is set. First key found wins: Grok -> Groq -> Gemini.
XAI_API_KEY=
GROK_MODEL=grok-2-latest
GROK_BASE_URL=https://api.x.ai/v1
GROK_TEMPERATURE=0.2
GROK_MAX_TOKENS=2000
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=120

# --- Embeddings (BGE or E5 via Sentence Transformers) -----------------------
# Examples: BAAI/bge-small-en-v1.5 | BAAI/bge-base-en-v1.5 | intfloat/e5-base-v2
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- ChromaDB (the ONLY database; persistent local storage) -----------------
CHROMA_PERSIST_DIRECTORY=ai/storage/chroma_db
LEGAL_DOCUMENTS_COLLECTION=legal_documents
LEGAL_CHUNKS_COLLECTION=legal_chunks
USERS_COLLECTION=users
CHAT_HISTORY_COLLECTION=chat_history

# --- Authentication (backend only - never expose to the frontend) -----------
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Uploads ----------------------------------------------------------------
UPLOAD_DIRECTORY=datasets/raw
MAX_UPLOAD_MB=50
ALLOWED_UPLOAD_EXTENSIONS=.pdf

# --- Retrieval --------------------------------------------------------------
TOP_K=5
MAX_TOP_K=20
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Web-search fallback (DuckDuckGo, no API key required) ------------------
# When the legal knowledge base has nothing relevant, the chatbot answers from
# web search. WEB_SEARCH_MAX_DISTANCE is the cosine-distance cutoff: if the best
# retrieved chunk is farther than this, the knowledge base is treated as empty.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MAX_DISTANCE=0.5

# --- OCR --------------------------------------------------------------------
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_MIN_TEXT_LENGTH=30

# --- Server -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api
